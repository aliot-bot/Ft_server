location / {
    root /var/www/kanatello;
    index index.html;
    autoindex on;
}

location /php/ {
    alias /var/www/wordpress/;
    index index.php;

    try_files $uri $uri/ /php/index.php?$args;

    location ~ ^/php/(.+\.php)$ {
        alias /var/www/wordpress/$1;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/wordpress/$1;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
}

location /phpmyadmin/ {
    alias /var/www/phpmyadmin/;
    index index.php;

    location ~ ^/phpmyadmin/(.+\.php)$ {
        alias /var/www/phpmyadmin/$1;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/phpmyadmin/$1;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
}